<style type="text/css">.offcanvas__logo{padding-top:0px;padding-right:0px;padding-bottom:30px;padding-left:0px;}.offcanvas__logo p{padding-top:20px;padding-right:0px;padding-bottom:10px;padding-left:0px;}.animation-preloader img{width:100px;height:200px;}</style><link rel="icon" href="https://markme.pl/wp-content/uploads/2024/06/cropped-logo_przyciete-e1717665105299-32x32.png" sizes="32x32">
<link rel="icon" href="https://markme.pl/wp-content/uploads/2024/06/cropped-logo_przyciete-e1717665105299-192x192.png" sizes="192x192">
<link rel="apple-touch-icon" href="https://markme.pl/wp-content/uploads/2024/06/cropped-logo_przyciete-e1717665105299-180x180.png">
