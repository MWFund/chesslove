		<style type="text/css" id="wp-custom-css">
			.dark .footer__social-3 li a:hover {
    color: #000;
}

.dark .sec-title-3 {
    color: #121212;
}
.dark .footer-menu li a {
    color: #000000;
}
.dark .footer__subscribe-2 form .subs-btn, .dark .footer_categories h4 {
    color: #212529;
}
.dark .footer__subscribe-2 input::placeholder {
    color: black !important;
}
.dark .footer__area-8 {
    background-color: unset !important;
}
.dark .footer__area-6 {
    background-color: var(--d-black-2) !important;
}
.dark .footer__area-5 {
    background-color: unset !IMPORTANT;
}


.dark .workflow__number {
    color: var(--gray-4);
}

.dark .footer__subscribe-2 form .subs-btn, .dark .footer_categories h4 {
    color: #ffffff;
}

.dark .footer__subscribe-2 input::placeholder {
    color: #ffff !important;
}

.dark .footer-menu li a, .dark .footer-menu-2 li a {
    color: var(--white) !important;
}

body * {
	text-transform: inherit !important
}

.hero__title-6  {
	font-size: 39px 
}
.hero__content-6 p {
	font-size: 18px;
	margin-top: 8px
}

.iti--show-flags input {
	padding-left: 55px !important;
}

.ff-el-form-check-label span {
	color: #fff !important;
}

.ff-el-repeat-buttons-list {
	background-color: #fff;
padding-left: 4px;
	border-radius: 8px
}
.ff-el-repeat-buttons-list:before {
	content: "DODAJ";
	padding-right:2px;
}

.ff_submit_btn_wrapper {
	margin-bottom: 0 !Important;
	
}
.ff_submit_btn_wrapper  button {
	height: 58px
}

/* Portfolio custom darkmode */
.portfolio__detail, .development__area {
	background-color:#fff !Important;
	filter:invert(1)
}
.portfolio__detail img, .development__area img {
	filter: invert(1)
}
/* Home hack btn */
.hero__content a {
	max-width: 330px !important;
	padding-right: 24px;
}

/* offcanvas fixes */
.offcanvas__logo {
	display: flex;
	justify-content: center;
	align-items: center;
	margin-top: 100px
}
.offcanvas__logo img {
	transform: scale(2)
}
.offcanvas__right {
	padding-top: 100px
}

/* Mobile footer */
@media screen and (max-width:768px){
	.footer__inner {
		text-align:center;
	}
}
.ff-el-tc a {
	color: #fff
}


.wpcf7-response-output {
	border-color: #fff !important;
	color: #fff;
}




/* disable links */
.disable-link .testimonial__item{
	pointer-events:none
}


.ff-message-success {
	margin-top: 64px !important;
	margin-bottom: 64px !important;
}


		</style>
